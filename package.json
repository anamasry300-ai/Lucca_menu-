{
  "name": "lucca-caffe-pos",
  "version": "1.3.5",
  "description": "Lucca Caffأ¨ - ظ†ط¸ط§ظ… ط¥ط¯ط§ط±ط© ط§ظ„ظ…ظ‚ظ‡ظ‰",
  "main": "main.js",
  "author": "Lucca Caffأ¨",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "build:installer": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.lucca.caffe.pos",
    "productName": "LuccaPOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-engine.js",
      "index.html",
      "kitchen.html",
      "styles.css",
      "admin/**/*",
      "ai-pos-engine.js",
      "batman-dashboard.js",
      "sync-engine.js",
      "forecasting.js",
      "knowledge-base.js",
      "knowledge/**/*",
      "report-export.js",
      "supabase-db.js",
      "ollama-adapter.js",
      "ocr-adapter.js",
      "invoice-scanner.js",
      "menu-data.js",
      "vendor/**/*",
      "version.json",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "LuccaPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "LuccaPOS-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "anamasry300-ai",
      "repo": "Lucca_menu-",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
