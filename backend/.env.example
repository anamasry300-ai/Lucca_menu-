PORT=3000
# H1: مفتاح جهاز خاص (device-scoped) لتزويد كشك POS. غيّره لكل نشر؛ لا يُخزّن حرفياً في الواجهة.
# لا مفتاح افتراضي حرفياً: يجب ضبطه في البيئة. عند غيابه يُقبل legacy API_KEY (نافذة هجرة فقط).
DEVICE_API_KEY=change-me-to-a-strong-random-device-key
# legacy (نافذة هجرة): لا تعتمد عليه كـ"سر" — un doctor device-scoped أيضاً.
API_KEY=[REDACTED]
ADMIN_PASSWORD=123456
JWT_SECRET=change-this-to-a-random-string

# ===== H1: LLM Proxy (بروكسي ChatGPT — يمنع CORS ويخفي المفتاح) =====
# مفتاح OpenAI: يضيفه العميل من الواجهة (مفتاح openai: sk-...) أو يُضبط هنا في البيئة.
# عند الغياب، لا يمكن استخدام المزود السحابي openai — فقط ollama المحلي المجاني.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ollama المحلي: الافتراضي يعمل بدون أي إعداد — /api/generate و /v1/chat/completions.
# غيّر COMPLETIONS_V1 فقط إذا نشرت Ollama على مسار مخصص.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
